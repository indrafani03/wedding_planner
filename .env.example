DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign the PIN session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-32-byte-hex-acak"

# PIN 4 angka untuk membuka aplikasi.
APP_PIN="1234"
